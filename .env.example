# 需要填写支持 Tool Calling 的 OpenAI 兼容聊天模型配置。
CHAT_MODEL=deepseek-chat
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com

# local：512 维字符 n-gram 哈希向量，无需下载；适合演示，不等同于语义模型。
# dashscope：百炼多模态 Embedding；openai：标准 /embeddings 接口。
EMBEDDING_MODE=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# 生成自己的随机值；启动脚本会自动补充，不能与旧项目共用。
SESSION_SECRET=
COMMERCE_HTTP_PORT=8891
COMMERCE_BIND_HOST=0.0.0.0
